{
  "manifest_version": 3,
  "name": "PhishTrace",
  "version": "0.1.0",
  "description": "Agentic phishing investigation assistant. Paste a suspicious email/link, right-click a link on any page, or turn on auto-protect to catch malicious sites as you browse.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "notifications", "storage", "webNavigation", "tabs"],
  "host_permissions": ["http://localhost:8000/*"]
}
